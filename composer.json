{
    "name": "wedevelopnl/silverstripe-articles",
    "description": "Articles module",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "articles",
        "blog",
        "news",
        "listing"
    ],
    "authors": [{
        "name": "WeDevelop",
        "email": "development@wedevelop.nl"
    }],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silverstripe/vendor-plugin": "^3.0",
        "silverstripe/lumberjack": "^4.1",
        "silverstripe/tagfield": "^4.1",
        "unclecheese/display-logic": "^4.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.20"
    },
    "extra": {
        "installer-name": "silverstripe-articles",
        "branch-alias": {
            "dev-main": "5.x-dev"
        },
        "expose": [
            "client/dist"
        ]
    },
    "autoload": {
        "psr-4": {
            "WeDevelop\\Articles\\": "src/"
        }
    }
}
